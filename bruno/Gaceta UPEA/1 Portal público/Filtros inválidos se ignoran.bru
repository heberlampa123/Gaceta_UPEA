meta {
  name: Filtros inválidos se ignoran
  type: http
  seq: 3
}

get {
  url: http://localhost:8000/api/documentos?gestion=abc&desde=2026-02-31&orden=xyz
  body: none
  auth: none
}

params:query {
  gestion: abc
  desde: 2026-02-31
  orden: xyz
}

assert {
  res.status: eq 200
}

tests {
  test("descarta los valores inválidos y usa el orden predeterminado", function () {
    const f = res.getBody().filtros;
    expect(f).to.not.have.property('gestion');
    expect(f).to.not.have.property('desde');
    expect(f.orden).to.equal('recientes');
  });
}

docs {
  Un enlace mal escrito no produce un error: los filtros inválidos simplemente se ignoran.
}
